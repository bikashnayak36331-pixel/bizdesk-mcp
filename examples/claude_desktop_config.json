{
  "mcpServers": {
    "bizdesk": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/bikashnayak36331-pixel/bizdesk-mcp",
        "bizdesk-mcp"
      ],
      "env": {
        "BIZDESK_DB": "~/BizDesk/bizdesk.db",
